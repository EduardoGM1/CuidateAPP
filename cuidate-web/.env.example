# Desarrollo local (`npm run dev`): URL de la API.
# Con el proxy de Vite (/api → localhost:3000) suele bastar vacío o la URL directa al backend.
VITE_API_BASE_URL=

# Producción: no uses este archivo para el build. Usa `.env.production`
