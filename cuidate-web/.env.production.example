# Variables para `vite build` (modo production).
# Copia este archivo a .env.production en el servidor antes del build, o usa:
#   bash deploy/rebuild-cuidate-web.sh "https://api.tudominio.com"
#   bash deploy/rebuild-cuidate-web.sh -
# (un guion fuerza URL vacía: mismo origen + rutas /api detrás de Nginx).

# URL base de la API (sin barra final).
# Vacío = rutas relativas al mismo host (recomendado si Nginx hace proxy de /api).
# Con API en otro subdominio: https://api.tudominio.com
VITE_API_BASE_URL=
