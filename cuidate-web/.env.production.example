# =============================================================================
# Build de producción (vite build) — copiar a .env.production o generar con:
#   bash deploy/rebuild-cuidate-web.sh -
#   bash deploy/rebuild-cuidate-web.sh "https://api.tudominio.com"
# =============================================================================

# URL base de la API (sin barra final).
#
# OPCIÓN A — Mismo origen (recomendado con nginx-cuidateapp*.conf que hace proxy /api):
#   VITE_API_BASE_URL=
#   Axios usará rutas relativas (/api/...). El navegador llama al mismo host que sirve la SPA.
#
# OPCIÓN B — API en otro host (ej. nginx-cuidateapp-domain.conf: web en tudominio.com, API en api.tudominio.com):
#   VITE_API_BASE_URL=https://api.tudominio.com
#
# En el backend (api-clinica/.env) debes incluir el origen de la web en ALLOWED_ORIGINS, por ejemplo:
#   ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com
# La CSP de deploy/nginx-security-headers.inc incluye connect-src https: wss: (compatible con subdominio API).

VITE_API_BASE_URL=
