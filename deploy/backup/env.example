# Copiar a /etc/cuidateapp/backup.env (chmod 600) — NO subir al repositorio con valores reales

# MySQL (usuario solo lectura para dump)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medical_db
DB_BACKUP_USER=backup_user
DB_BACKUP_PASSWORD=cambiar_password_seguro

# Directorio de respaldos en el VPS
BACKUP_ROOT=/var/backups/cuidateapp

# Retención
BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=8

# Cifrado opcional (gpg simétrico). Dejar vacío para solo .sql.gz
BACKUP_GPG_PASSPHRASE=

# Tipo: daily | weekly (el cron define cuál)
BACKUP_TYPE=daily

# Notificación (ruta al proyecto api-clinica para notify-backup.js)
API_CLINICA_DIR=/var/www/cuidateapp/api-clinica
# Correos admin separados por coma (si vacío, el script usa BACKUP_NOTIFY_EMAILS del .env de la API)
BACKUP_NOTIFY_EMAILS=admin@clinica.com

# Copia externa opcional (descomentar tras configurar rclone)
# RCLONE_REMOTE=backblaze:cuidateapp-backups
